{
  "name": "adhd-test-backend",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\" \"prisma/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main.js",
    "lint": "eslint \"{src,test,prisma}/**/*.{ts,mjs}\"",
    "lint:fix": "eslint \"{src,test,prisma}/**/*.{ts,mjs}\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:e2e": "node test/attempt-flow.e2e.mjs",
    "quality": "eslint \"{src,test,prisma}/**/*.{ts,mjs}\" && nest build && jest --runInBand && node test/attempt-flow.e2e.mjs",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@nestjs/common": "12.1.0",
    "@nestjs/config": "12.0.1",
    "@nestjs/core": "12.1.0",
    "@nestjs/jwt": "12.0.2",
    "@nestjs/platform-express": "12.1.0",
    "@nestjs/swagger": "12.0.2",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "bcryptjs": "3.0.3",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "cookie-parser": "1.4.7",
    "dotenv": "18.0.3",
    "pg": "8.23.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.7",
    "@eslint/js": "10.0.1",
    "@nestjs/cli": "12.0.6",
    "@nestjs/schematics": "12.0.5",
    "@nestjs/testing": "12.1.0",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/jest": "30.0.0",
    "@types/node": "26.6.2",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "eslint": "10.11.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.6",
    "globals": "17.12.0",
    "jest": "30.5.2",
    "prettier": "3.9.9",
    "prisma": "7.10.0",
    "source-map-support": "0.5.21",
    "supertest": "7.3.0",
    "ts-jest": "29.4.13",
    "ts-loader": "9.6.2",
    "ts-node": "10.9.2",
    "tsconfig-paths": "4.2.0",
    "tsx": "4.23.15",
    "typescript": "6.0.2",
    "typescript-eslint": "8.70.1"
  }
}
